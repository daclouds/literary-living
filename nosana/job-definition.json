{
  "version": "0.1",
  "type": "container",
  "ops": [
    {
      "type": "container/run",
      "id": "generate-room",
      "args": {
        "image": "pytorch/pytorch@sha256:77f17f843507062875ce8be2a6f76aa6aa3df7f9ef1e31d9d7432f4b0f563dee",
        "gpu": true,
        "entrypoint": [
          "/bin/bash",
          "-lc"
        ],
        "cmd": [
          "set -euo pipefail; python -m pip install --no-cache-dir diffusers==0.32.2 transformers==4.48.3 accelerate==1.3.0 safetensors==0.5.2 huggingface-hub==0.28.1 Pillow==11.1.0 requests==2.32.5; python -c 'import os,base64; exec(compile(base64.b64decode(os.environ[\"LL_WORKER_CODE_B64\"]),\"worker.py\",\"exec\"))'"
        ],
        "env": {
          "LL_CALLBACK_URL": "https://example.invalid",
          "LL_JOB_ID": "configuration-check",
          "LL_JOB_TOKEN": "setup-only-no-access",
          "LL_WORKER_CODE_B64": "",
          "PYTHONUNBUFFERED": "1",
          "HF_HUB_DISABLE_TELEMETRY": "1",
          "LL_SETUP_ONLY": "1"
        },
        "restart_policy": "no"
      },
      "execution": {
        "timeout": 1200
      }
    }
  ],
  "meta": {
    "trigger": "literary-living",
    "mode": "one-image-per-job"
  },
  "deployment_id": "Aa2BjYJuDjS9vbN5rpDrJM2qGF9Ak6fz9esSuFESRcsa"
}
